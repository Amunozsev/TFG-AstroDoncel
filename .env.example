# Copy this file to .env before running Docker Compose.
# scripts/docker-up.ps1 and scripts/docker-up.sh generate a random password.
# If configuring this file manually, replace both password occurrences.
POSTGRES_DB=astrodoncel
POSTGRES_USER=astrodoncel
POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql+psycopg://astrodoncel:change-this-password@db:5432/astrodoncel

# Application cache/artifacts. The named volume is the portable default.
# On a NAS this may be an absolute bind path, e.g.
# APP_DATA_SOURCE=/volume1/docker/astrodoncel/data
APP_DATA_SOURCE=app_data

# Host directory containing an optional YYYY/MM/DD e-CALLISTO archive.
# It is mounted read-only and may remain empty when ETHZ is used remotely.
ECALLISTO_HOST_DIR=./data/archive
ECALLISTO_DATA_DIR=/archive/ecallistodata

# Public web port on the Docker host.
WEB_PORT=8080

# Browser origins allowed to call the API directly.
FRONTEND_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Keep ONNX CPU usage predictable on small hosts and NAS devices.
BURST_INTRA_OP_THREADS=1
WORKER_MEMORY_LIMIT=1g
WORKER_CPU_LIMIT=2.0

# Queue, cache and remote-download safety limits.
MAX_ACTIVE_TASKS=100
TASK_STALE_MINUTES=15
TASK_RETENTION_DAYS=30
MAX_FITS_DOWNLOAD_BYTES=134217728
# Automatic cleanup applies only to FITS downloaded into APP_DATA_SOURCE.
# The separately mounted e-CALLISTO archive is read-only and is never pruned.
FITS_CACHE_MAX_GB=20
FITS_CACHE_MAX_AGE_DAYS=90
FITS_CACHE_MIN_IDLE_MINUTES=60
FITS_CACHE_MIN_FREE_GB=5
FITS_CACHE_PRUNE_INTERVAL_HOURS=6
# Keep false until the dry-run output has been reviewed on the deployment host.
FITS_CACHE_PRUNE_APPLY=false
CATALOG_REFRESH_HOURS=12
CATALOG_FETCH_TIMEOUT_SECONDS=12
# Optional authoritative Burst Reports source on the NAS. Keep the password in
# .env only. If the password contains '$', enclose the value in single quotes.
# The table/view may be left empty when exactly one compatible source exists.
BURST_CATALOG_SOURCE=dearce_v3
BURST_SOURCE_MYSQL_HOST=
BURST_SOURCE_MYSQL_PORT=
BURST_SOURCE_MYSQL_DATABASE=srbs_callisto
BURST_SOURCE_MYSQL_USER=
BURST_SOURCE_MYSQL_PASSWORD=
BURST_SOURCE_MYSQL_TABLE=
BURST_SOURCE_MYSQL_TIMEOUT_SECONDS=8
BURST_SOURCE_REFRESH_MINUTES=60
STATION_REFRESH_MINUTES=60
STATION_RETENTION_DAYS=90
ARCHIVE_INDEX_REFRESH_MINUTES=60
OVERVIEW_MAX_STATIONS=120
OVERVIEW_MAX_HOURS=72
XMATCH_NOMINAL_BLOCK_MINUTES=15
